{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hospitalisation bar — hospitalisations.csv",
  "width": "container", "height": 260,
  "data": {"url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/hospitalisations.csv"},
  "params": [{"name": "hh", "select": {"type": "point", "on": "mouseover", "clear": "mouseout", "fields": ["substance"]}}],
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadius": 2},
      "encoding": {
        "y": {"field": "substance", "type": "nominal", "sort": "-x", "title": null, "axis": {"labelFontSize": 12, "labelColor": "#3B2A14", "grid": false}},
        "x": {"field": "hospitalisations", "type": "quantitative", "title": "Annual hospitalisations", "axis": {"grid": true, "format": ","}},
        "color": {
          "field": "substance", "type": "nominal", "legend": null,
          "scale": {"scheme": "browns"}
        },
        "opacity": {"condition": {"param": "hh", "value": 1}, "value": 0.4},
        "tooltip": [
          {"field": "substance",       "type": "nominal",      "title": "Substance"},
          {"field": "hospitalisations","type": "quantitative", "title": "Hospitalisations", "format": ","}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 6, "fontSize": 11, "fontWeight": 700},
      "encoding": {
        "y": {"field": "substance", "type": "nominal", "sort": "-x"},
        "x": {"field": "hospitalisations", "type": "quantitative"},
        "text": {"field": "hospitalisations", "type": "quantitative", "format": ","},
        "color": {"field": "substance", "type": "nominal", "legend": null, "scale": {"scheme": "browns"}},
        "opacity": {"condition": {"param": "hh", "value": 1}, "value": 0.4}
      }
    }
  ],
  "config": {
    "background": "transparent", "font": "Lato, sans-serif", "view": {"stroke": null, "fill": "transparent"},
    "axis": {"domain": false, "ticks": false, "labelFontSize": 11, "labelColor": "#7A6040", "labelPadding": 6, "titleFontSize": 11, "titleFontWeight": 700, "titleColor": "#3B2A14", "titlePadding": 10, "gridColor": "#E8DFD0"},
    "legend": {"labelFontSize": 11, "labelColor": "#7A6040", "titleFontSize": 11, "titleColor": "#3B2A14", "symbolSize": 100, "padding": 6, "cornerRadius": 2, "fillColor": "#FAF7F0", "strokeColor": "#C8B89A"},
    "bar": {"cornerRadius": 2}
  }
}
