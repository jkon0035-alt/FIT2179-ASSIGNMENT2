{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hospitalisation bar — cream styled bars",
  "width": "container",
  "height": 260,

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/hospitalisations.csv"
  },

  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout",
        "fields": ["drug_group"]
      }
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadius": 4,
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "y": {
      "field": "drug_group",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },

    "x": {
      "field": "hospitalisations",
      "type": "quantitative",
      "title": "Annual hospitalisations"
    },

    "color": {
      "field": "drug_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Alcohol",
          "Meth/Stimulants",
          "Sedatives",
          "Cannabis",
          "Opioids",
          "Cocaine",
          "Other"
        ],
        "range": [
          "#B89A5C",
          "#7A3E34",
          "#7B6C8E",
          "#4F6F5D",
          "#3E6B67",
          "#A8643F",
          "#9C9C9C"
        ]
      },
      "legend": null
    },

    "opacity": {
      "condition": {
        "param": "hover",
        "value": 0.95
      },
      "value": 0.75
    },

    "tooltip": [
      {"field": "drug_group", "type": "nominal"},
      {"field": "hospitalisations", "type": "quantitative", "format": ","}
    ]
  },

  "config": {
    "background": "white"
  }
}
