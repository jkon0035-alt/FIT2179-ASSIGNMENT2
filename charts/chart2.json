{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Smoking trends by gender",
  "width": 600,
  "height": 260,
  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-by-gender-trend.csv"
  },
  "transform": [
    {"filter": "datum.gender != 'Persons'"}
  ],
  "layer": [
    {
      "mark": {"type": "line","interpolate": "monotone","strokeWidth": 3},
      "encoding": {
        "x": {"field": "year","type": "quantitative","title": "Year",
          "axis": {"format": "d","grid": false}
        },
        "y": {"field": "daily_smoking_percent","type": "quantitative","title": "Daily smoking (%)",
          "scale": {
            "domain": [0,26]
          }
        },
        "color": {"field": "gender","type": "nominal","title": "Gender",
          "scale": {
            "domain": ["Male","Female"],
            "range": ["#8B4513","#C9789B"]
          },
          "legend": {
            "orient": "top-right"
          }
        },
        "tooltip": [
          {"field": "year","type": "quantitative", "format": "d","title": "Year"},
          {"field": "gender","type": "nominal","title": "Gender"},
          {"field": "daily_smoking_percent","type": "quantitative","title": "Smoking (%)","format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {"type": "point","filled": true,"size": 85,"stroke": "#FAF7F0","strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "year","type": "quantitative"},
        "y": {"field": "daily_smoking_percent","type": "quantitative"},
        "color": {"field": "gender","type": "nominal","legend": null,
          "scale": {
            "domain": ["Male","Female"],
            "range": ["#8B4513","#C9789B"]
          }
        },
        "tooltip": [
          {"field": "year","type": "quantitative","format": "d","title": "Year"},
          {"field": "gender","type": "nominal","title": "Gender"},
          {"field": "daily_smoking_percent","type": "quantitative","title": "Smoking (%)","format": ".1f"}
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": 700
      },

      "transform": [
        {"filter": "datum.year == 2023"}
      ],

      "encoding": {

        "x": {
          "field": "year",
          "type": "quantitative"
        },

        "y": {
          "field": "daily_smoking_percent",
          "type": "quantitative"
        },

        "text": {
          "field": "gender"
        },

        "color": {
          "field": "gender",
          "type": "nominal",
          "legend": null,

          "scale": {
            "domain": ["Male","Female"],
            "range": ["#8B4513", "#B03030"]
          }
        }
      }
    }

  ],

  "config": {

    "background": "transparent",

    "font": "Lato, sans-serif",

    "view": {
      "stroke": null,
      "fill": "transparent"
    },

    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "labelColor": "#7A6040",
      "titleFontSize": 11,
      "titleColor": "#3B2A14",
      "gridColor": "#E8DFD0"
    },

    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#7A6040",
      "titleColor": "#3B2A14",
      "fillColor": "#FAF7F0",
      "strokeColor": "#D9C7A7",
      "cornerRadius": 4,
      "padding": 6
    }
  }
}
