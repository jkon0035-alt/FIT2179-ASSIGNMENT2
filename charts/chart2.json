{
  "$schema":"https://vega.github.io/schema/vega-lite/v5.json",

  "description":"Gender smoking trend in Australia",

  "width":"container",
  "height":260,

  "data":{
    "url":"https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-by-gender-trend.csv"
  },

  "transform":[
    {"filter":"datum.gender != 'Persons'"}
  ],

  "layer":[

    {
      "mark":{
        "type":"area",
        "interpolate":"monotone",
        "opacity":0.14
      },

      "encoding":{

        "x":{"field":"year","type":"quantitative"},

        "y":{
          "field":"daily_smoking_percent",
          "type":"quantitative",
          "stack":false
        },

        "color":{
          "field":"gender",
          "type":"nominal",

          "scale":{
            "domain":["Male","Female"],
            "range":["#D8A07A","#E8B7CC"]
          },

          "legend":null
        }
      }
    },

    {
      "mark":{
        "type":"line",
        "strokeWidth":3,
        "strokeCap":"round",
        "interpolate":"monotone"
      },

      "encoding":{

        "x":{
          "field":"year",
          "type":"quantitative",

          "title":"Year",

          "axis":{
            "format":"d",
            "grid":false
          }
        },

        "y":{
          "field":"daily_smoking_percent",
          "type":"quantitative",

          "title":"Daily smoking (%)",

          "scale":{
            "domain":[0,26]
          },

          "axis":{
            "grid":true
          }
        },

        "color":{
          "field":"gender",
          "type":"nominal",

          "title":"Gender",

          "scale":{
            "domain":["Male","Female"],
            "range":["#8B4513","#C25E8B"]
          },

          "legend":{
            "orient":"top-right"
          }
        },

        "tooltip":[
          {
            "field":"year",
            "type":"quantitative",
            "title":"Year",
            "format":"d"
          },

          {
            "field":"gender",
            "type":"nominal",
            "title":"Gender"
          },

          {
            "field":"daily_smoking_percent",
            "type":"quantitative",
            "title":"Daily smoking (%)",
            "format":".1f"
          }
        ]
      }
    },

    {
      "mark":{
        "type":"point",
        "filled":true,
        "size":70,
        "stroke":"white",
        "strokeWidth":1.5
      },

      "encoding":{

        "x":{
          "field":"year",
          "type":"quantitative"
        },

        "y":{
          "field":"daily_smoking_percent",
          "type":"quantitative"
        },

        "color":{
          "field":"gender",
          "type":"nominal",

          "scale":{
            "domain":["Male","Female"],
            "range":["#8B4513","#C25E8B"]
          },

          "legend":null
        }
      }
    },

    {
      "transform":[
        {"filter":"datum.year == 2023"}
      ],

      "mark":{
        "type":"text",
        "align":"left",
        "dx":8,
        "fontSize":11,
        "fontWeight":"bold"
      },

      "encoding":{

        "x":{
          "field":"year",
          "type":"quantitative"
        },

        "y":{
          "field":"daily_smoking_percent",
          "type":"quantitative"
        },

        "text":{
          "field":"gender"
        },

        "color":{
          "field":"gender",
          "type":"nominal",

          "scale":{
            "domain":["Male","Female"],
            "range":["#8B4513","#C25E8B"]
          },

          "legend":null
        }
      }
    }
  ],

  "config":{

    "background":"transparent",

    "font":"Lato, sans-serif",

    "view":{
      "stroke":null,
      "fill":"transparent"
    },

    "axis":{
      "domain":false,
      "ticks":false,
      "labelFontSize":11,
      "labelColor":"#7A6040",
      "titleFontSize":11,
      "titleFontWeight":700,
      "titleColor":"#3B2A14",
      "gridColor":"#E8DFD0"
    },

    "legend":{
      "labelFontSize":11,
      "labelColor":"#7A6040",
      "titleFontSize":11,
      "titleColor":"#3B2A14",
      "symbolSize":100,
      "padding":6,
      "cornerRadius":2,
      "fillColor":"#FAF7F0",
      "strokeColor":"#C8B89A"
    }
  }
}
