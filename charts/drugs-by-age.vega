{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who Smokes In Australia?",
    "subtitle": "Daily smoking rate by age group and gender, 2022–23",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "data": {
  "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/drug-by-age.csv"
  },

  "params": [
    {
      "name": "e",
      "select": {
        "type": "point",
        "fields": ["drug"]
      }
    }
  ],
  "hconcat": [
    {
      "title": {
        "text": "Heatmap: Use Rate by Age x Drug",
        "fontSize": 13
      },
      "width": 300,
      "height": 250,

      "mark": {"type": "rect", "cornerRadius": 3},
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "title": "Age Group"
        },
        "x": {
          "field": "drug",
          "type": "ordinal",
          "title": "Drug Types",
          "axis": {"labelAngle": 35}
        },
        "color": {
          "field": "recent_use_percent",
          "type": "quantitative",
          "title": "Recent Use (%)",
          "scale": {"scheme": "blues", "domain": [0,25]},
          "legend": {"orient": "bottom", "gradientLength": 300}
        },
        "opacity":{
            "condition":{
            "param": "e",
            "value": 1
          },
        "value": 0.2
        },
      "tooltip": [
          {"field": "age_group", "type": "ordinal", "title": "Age Group"},
          {"field": "drug", "type": "nominal", "title": "Drug Type"},
          {"field": "recent_use_percent", "type": "quantitative", "title": "Daily Smoking (%)", "format": ".1f"}
        ]
      }
    },
    {
      "title": {
        "text": "Bar: Rate by Age (Click a drug row to filter)",
        "fontSize": 13
      },
      "width": 300,
      "height": 250,
      "transform": [
        {
          "filter":{"param": "e"}
        }
      ],

      "mark": {"type": "bar", "cornerRadius": 2},
      "encoding": {
        "x": {
          "field": "recent_use_percent",
          "type": "quantitative",
          "title": "Use Rate (%)"
        },
        "y": {
          "field": "age_group",
          "type": "nominal",
          "title": "Age Group",
          "axis": {"labelFontSize": 11}
        },
        "color": {
          "field": "drug",
          "type": "nominal",
          "title": "Drug Types",
          "scale": {"scheme":"blues"},
          "legend": {"orient": "bottom", "labelFontSize": 11}
        },

      "tooltip": [
          {"field": "age_group", "type": "ordinal", "title": "Age Group"},
          {"field": "drug", "type": "nominal", "title": "Drug Type"},
          {"field": "recent_use_percent", "type": "quantitative", "title": "Daily Smoking (%)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
  "background": "transparent",
  "view": {"stroke": null}
  }
}
