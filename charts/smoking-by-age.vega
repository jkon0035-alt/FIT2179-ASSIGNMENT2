{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Smoking by Age Group and Gender",
    "subtitle": "Daily smoking rate (%) | Click Legend to filter",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 600,
  "height": 400,
  "data": {
  "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-by-age.csv"
  },

      "params": [
    {
      "name": "e",
      "select": {
        "type": "point",
        "fields": ["gender"]
      },
      "bind": "legend"
    }
  ],
  "mark": {"type": "bar", "cornerRadius": 4},
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age Group",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "percent",
      "type": "quantitative",
      "title": "Proportion (%)",
      "axis": {"format": ".1f"}
    },
    "xOffset": {
      "field": "gender",
      "sort": ["Male","Female"]
    },
    "color": {
      "field": "gender",
      "type": "nominal",
      "title": "Gender",
      "scale": {
        "domain": ["Male","Female"],
        "range": ["#336683", "#9D0910"]
      },
      "legend": {
        "orient": "top-right"
      }
    },
    "opacity": {
      "condition":{"param": "e", "value" : 1},
      "value": 0.1
    },
   "tooltip": [
      {"field": "age_group", "type": "ordinal", "title": "Age Group"},
      {"field": "gender", "type": "nominal", "title": "Gender"},
      {"field": "percent", "type": "quantitative", "title": "Daily Smoking (%)", "format": ".1f"}
    ]
  },
  "config": {
  "background": "transparent",
  "view": {"stroke": null}
  }
}
