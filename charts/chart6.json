{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging bar — vaping-vs-smoking-by-age.csv",
  "width": "container", "height": 300,
  "data": {"url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/vaping-vs-smoking-by-age.csv"},
  "params": [{"name": "ah", "select": {"type": "point", "on": "mouseover", "clear": "mouseout", "fields": ["age_group"]}}],
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadius": 2},
      "encoding": {
        "y": {"field": "age_group", "type": "nominal", "title": "Age group", "axis": {"grid": false, "labelColor": "#3B2A14"}},
        "x": {"field": "percent", "type": "quantitative", "title": "← Smoking decline (%)  |  Vaping rate (%) →", "axis": {"grid": true, "values": [-15,-10,-5,0,5,10,15,20]}},
        "color": {
          "field": "substance", "type": "nominal", "title": null,
          "scale": {"domain": ["Smoking (daily)","Vaping (current)"], "range": ["#8B4513","#4A7C8B"]},
          "legend": {"orient": "bottom"}
        },
        "opacity": {"condition": {"param": "ah", "value": 1}, "value": 0.3},
        "tooltip": [
          {"field": "age_group", "type": "nominal", "title": "Age Group"},
          {"field": "substance", "type": "nominal", "title": "Substance"},
          {"field": "percent", "type": "quantitative", "title": "Rate (%)", "format": ".1f"}
        ]
      }
    },
    {"mark": {"type": "rule", "color": "#7A6040", "strokeWidth": 1}, "encoding": {"x": {"datum": 0}}}
  ],
  "config": {
    "background": "transparent", "font": "Lato, sans-serif", "view": {"stroke": null, "fill": "transparent"},
    "axis": {"domain": false, "ticks": false, "labelFontSize": 11, "labelColor": "#7A6040", "labelPadding": 6, "titleFontSize": 11, "titleFontWeight": 700, "titleColor": "#3B2A14", "titlePadding": 10, "gridColor": "#E8DFD0"},
    "legend": {"labelFontSize": 11, "labelColor": "#7A6040", "titleFontSize": 11, "titleColor": "#3B2A14", "symbolSize": 100, "padding": 6, "cornerRadius": 2, "fillColor": "#FAF7F0", "strokeColor": "#C8B89A"},
    "bar": {"cornerRadius": 2}
  }
}
