{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging bar — smoking vs vaping by age group",
  "width": "container",
  "height": 300,

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/vaping-vs-smoking-by-age.csv"
  },

  "params": [
    {
      "name": "fit2179_hover_age_v1",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],

  "mark": { "type": "bar", "cornerRadius": 2 },

  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "axis": { "grid": false, "labelColor": "#3B2A14" }
    },

    "x": {
      "field": "percent",
      "type": "quantitative",
      "axis": {
        "grid": true,
        "values": [-20,-15,-10,-5,0,5,10,15,20]
      }
    },

    "color": {
      "field": "substance",
      "type": "nominal",
      "scale": {
        "range": ["#6B3E2E", "#A67C52"]
      },
      "legend": null
    },

    "opacity": {
      "condition": {
        "param": "fit2179_hover_age_v1",
        "value": 1
      },
      "value": 0.35
    },

    "tooltip": [
      { "field": "age_group", "type": "nominal" },
      { "field": "substance", "type": "nominal" },
      { "field": "percent", "type": "quantitative" }
    ]
  },

  "config": {
    "background": "transparent",
    "view": { "stroke": null }
  }
}
