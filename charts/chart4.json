{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected dot plot — smoking rate by age group and gender",

  "width": 480,
  "height": 260,

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-by-age.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.percent)",
      "as": "value"
    },
    {
      "calculate": "indexof(['14–19','20–29','30–39','40–49','50–59','60+'], datum.age_group)",
      "as": "age_order"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": { "field": "age_order", "order": "ascending" },
          "title": "Age Group",
          "axis": {
            "labelAngle": -25,
            "labelColor": "#7A6040",
            "grid": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Smoking Rate (%)",
          "axis": {
            "labelColor": "#3B2A14",
            "gridColor": "#E8DFD0"
          }
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "scale": {
            "range": [  "#8B4513","#c9789b"]
          }
        },
        "detail": {
          "field": "gender"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": { "field": "age_order", "order": "ascending" }
        },
        "y": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "field": "gender",
          "type": "nominal",
          "scale": {
            "range": ["#1F4E79", "#C9789B"]
          }
        },
        "tooltip": [
          { "field": "age_group", "title": "Age Group" },
          { "field": "gender", "title": "Gender" },
          { "field": "value", "title": "Smoking (%)" }
        ]
      }
    }
  ],

  "config": {
    "background": "transparent",
    "view": { "stroke": null },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelFont": "Lato"
    }
  }
}
