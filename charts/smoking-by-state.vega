{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Every State Daily Smoking Decline (2007 - 2023)",
    "subtitle": "Slope steepness = speed of decline | Click legend to highlight data",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 600,
  "height": 400,
  "data": {
  "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-by-state.csv"
  },
    "layer": [
    {
      "params": [
      {
        "name": "e",
        "select": {
          "type": "point",
          "fields": ["state"]
        },
        "bind": "legend"
      }
    ],
      "mark": {
        "type": "line", 
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year", 
          "type": "ordinal", 
          "title": "Year", 
          "axis": {"labelAngle": 0}
        },
        "y": {
          "field": "daily_smoking_percent", 
          "type": "quantitative", 
          "title": "Daily Smoking (%)", 
          "scale": {"domain": [0, 30]}
        },
        "color": {
          "field": "state", 
          "type": "nominal", 
          "title": "State",
          "scale": {
            "domain" : ["ACT", "NSW", "NT", "Qld", "SA", "Tas", "Vic", "WA"],
          "range": ["#005F73","#0A9396", "#94D2BD", "#F4D35E","#EE9B00","#CA6702","#BB3E03","#AE2012"]
        },
          "legend": {"orient": "right", "labelFontSize": 10}
        },
        "opacity": {
          "condition":{"param": "e", "value" : 0.9},
          "value": 0.1
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "daily_smoking_percent", "type": "quantitative", "title": "Daily Smoking (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "point", "size": 100, "filled": true, "strokeWidth": 1.5},
      "encoding": {
        "x": {
          "field": "year", 
          "type": "ordinal"
        },
        "y": {
          "field": "daily_smoking_percent", 
          "type": "quantitative"
        },
        "color": {
          "field": "state", 
          "type": "nominal",
        "scale": {
          "domain" : ["ACT", "NSW", "NT", "Qld", "SA", "Tas", "Vic", "WA"],
          "range": ["#005F73","#0A9396", "#94D2BD", "#C1B75F","#EE9B00","#CA6702","#BB3E03","#AE2012"]
        }
      },
      "opacity": {
          "condition":{"param": "e", "value" : 1},
          "value": 0.1
        }
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 6, "fontSize": 9.5, "fontWeight": 600},
      "encoding": {
        "x": {
          "field": "year", 
          "type": "ordinal"
        },
        "y": {
          "field": "daily_smoking_percent", 
          "type": "quantitative"
        },
        "text": {
          "field": "state"}
          ,
        "color": {
          "field": "state", 
          "type": "nominal"
      },
      "opacity": {
          "condition":{"param": "e", "value" : 1},
          "value": 0.15
        }
      }
    }
  ],
  "config": {
  "background": "transparent",
  "view": {"stroke": null}
  }
}
