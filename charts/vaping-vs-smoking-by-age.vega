{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Vaping Rises When Smoking Declines",
    "subtitle": "Left = Smoking Decline since 2001 | Right = 2023 vaping rate | Hover to compare data ",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": 600,
  "height": 400,
  "data": {
  "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/vaping-vs-smoking-by-age.csv"
  },

  "params": [
    {
      "name": "e",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout",
        "fields": ["age_group"]
      }
    }
  ],
  "mark": {"type": "bar", "cornerRadius": 4},
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age Group",
      "axis": {"labelAngle": 0}
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "title": "<---------- Smoking Decline(%) | Vaping Rate (%) ----------> ",
      "axis": {
        "values": [
          -20, -15, -10, -5, 0, 5, 10, 15, 20
        ]
      }
    },
    "color": {
      "field": "substance",
      "type": "nominal",
      "title": "Substance",
      "scale": {
        "domain": ["Smoking (daily)", "Vaping (current)"],
        "range": ["#73C3C6", "#C9CCA2"]
      }
    },
    "opacity":{
        "condition":{
        "param": "e",
        "value": 1
      },
      "value": 0.30
    },
    "tooltip": [
      {"field": "age_group", "type": "ordinal", "title": "Age Group"},
      {"field": "substance", "type": "nominal", "title": "Substance"},
      {"field": "percent", "type": "quantitative", "title": "Rate (%)", "format": ".1f"}
    ]
  },
  "config": {
  "background": "transparent",
  "view": {"stroke": null}
  }
}
