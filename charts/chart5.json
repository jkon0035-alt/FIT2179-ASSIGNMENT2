{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Vaping heatmap with cream-friendly colours",
  "width": 600,
  "height": 380,

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/vaping-trend.csv"
  },

  "layer": [

    {
      "mark": { "type": "rect" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal", "title": "Year" },
        "y": { "field": "age_group", "type": "nominal", "title": "Age Group" },

        "color": {
          "field": "vaping_percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 22],
            "range": ["#FAF7F0", "#E8D8B0", "#C8B89A", "#8C6F4E"]
          }
        },

        "tooltip": [
          { "field": "age_group", "type": "nominal" },
          { "field": "year", "type": "ordinal" },
          { "field": "vaping_percent", "type": "quantitative" }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#3B2A14"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "age_group", "type": "nominal" },
        "text": { "field": "vaping_percent", "type": "quantitative", "format": ".1f" }
      }
    }

  ],

  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#7A6040",
      "titleColor": "#3B2A14"
    }
  }
}
