{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Animated bar + slider — drug-trends.csv",
  "width": "container",
  "height": 260,

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/drug-trends.csv"
  },

  "params": [
    {
      "name": "yr",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2023,
        "step": 3,
        "name": "Survey year: "
      }
    },
    {
      "name": "sel",
      "select": {
        "type": "point",
        "fields": ["drug"],
        "on": "click",
        "clear": "dblclick"
      }
    }
  ],

  "transform": [
    { "filter": "datum.year == yr" }
  ],

  "mark": {
    "type": "bar",
    "cornerRadius": 4
  },

  "encoding": {
    "y": {
      "field": "drug",
      "type": "nominal",
      "sort": null,
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelColor": "#3B2A14",
        "labelPadding": 8,
        "domain": true,
        "ticks": true
      }
    },

    "x": {
      "field": "recent_use_percent",
      "type": "quantitative",
      "title": "Recent use (%)",
      "scale": { "domain": [0, 14] },
      "axis": { "grid": true }
    },

    "color": {
      "field": "drug",
      "type": "nominal",
      "scale": {
        "range": [
          "#80A38A",
          "#CDAC8B",
          "#C17C74"
        ]
      },
      "legend": {
        "title": "Drug Type"
      }
    },

    "opacity": {
      "condition": {
        "param": "sel",
        "value": 1
      },
      "value": 0.35
    },

    "tooltip": [
      { "field": "drug", "type": "nominal", "title": "Drug" },
      { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
      { "field": "recent_use_percent", "type": "quantitative", "title": "Recent Use (%)", "format": ".1f" }
    ]
  },

  "config": {
    "background": "transparent",
    "font": "Lato, sans-serif",

    "view": {
      "stroke": null,
      "fill": "transparent"
    },

    "padding": {
      "left": 100,
      "right": 20,
      "bottom": 20,
      "top": 70
    },

    "axis": {
      "domain": true,
      "ticks": true,
      "labelFontSize": 11,
      "labelColor": "#7A6040",
      "gridColor": "#E8DFD0",
      "titleFontSize": 11,
      "titleFontWeight": 700,
      "titleColor": "#3B2A14"
    },

    "legend": {
      "labelFontSize": 11,
      "labelColor": "#7A6040",
      "symbolSize": 100,
      "padding": 6
    },

    "bar": {
      "cornerRadius": 3
    }
  }
}
