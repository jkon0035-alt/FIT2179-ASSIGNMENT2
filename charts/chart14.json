{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Scatter + regression \u2014 all-substances-by-state.csv",
  "width": 500,
  "height": 340,
  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/all-substances-by-state.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#C8B89A",
        "strokeDash": [
          6,
          4
        ],
        "strokeWidth": 1.5
      },
      "transform": [
        {
          "regression": "drugs",
          "on": "smoking"
        }
      ],
      "encoding": {
        "x": {
          "field": "smoking",
          "type": "quantitative"
        },
        "y": {
          "field": "drugs",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#FAF7F0",
        "strokeWidth": 2,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "smoking",
          "type": "quantitative",
          "title": "Daily smoking rate (%)",
          "scale": {
            "domain": [
              4,
              15
            ]
          },
          "axis": {
            "grid": true
          }
        },
        "y": {
          "field": "drugs",
          "type": "quantitative",
          "title": "Illicit drug use rate (%)",
          "scale": {
            "domain": [
              13,
              27
            ]
          },
          "axis": {
            "grid": true
          }
        },
        "size": {
          "field": "vaping",
          "type": "quantitative",
          "title": "Vaping rate (%)",
          "scale": {
            "range": [
              80,
              600
            ]
          },
          "legend": {
            "orient": "bottom-right",
            "titleFontSize": 10,
            "labelFontSize": 10,
            "values": [
              4,
              5,
              6,
              7,
              8
            ]
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "ACT",
              "NSW",
              "NT",
              "Qld",
              "SA",
              "Tas",
              "Vic",
              "WA"
            ],
            "range": [
              "#4A7C8B",
              "#D2691E",
              "#B03030",
              "#4A7C59",
              "#C25E8B",
              "#E0A030",
              "#8B4513",
              "#7B68EE"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "state_full",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "smoking",
            "type": "quantitative",
            "title": "Smoking (%)",
            "format": ".1f"
          },
          {
            "field": "vaping",
            "type": "quantitative",
            "title": "Vaping (%)",
            "format": ".1f"
          },
          {
            "field": "drugs",
            "type": "quantitative",
            "title": "Drug Use (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": 700,
        "font": "Lato, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "smoking",
          "type": "quantitative"
        },
        "y": {
          "field": "drugs",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "value": "#3B2A14"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "Lato, sans-serif",
    "view": {
      "stroke": null,
      "fill": "transparent"
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelColor": "#7A6040",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleColor": "#3B2A14",
      "titlePadding": 8,
      "gridColor": "#E8DFD0"
    },
    "legend": {
      "labelColor": "#7A6040",
      "titleColor": "#3B2A14",
      "padding": 6,
      "fillColor": "#FAF7F0",
      "strokeColor": "#C8B89A"
    }
  }
}
