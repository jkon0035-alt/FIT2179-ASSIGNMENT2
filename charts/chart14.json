{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Clean interactive scatter — smoking vs drugs with vaping intensity",

  "width": "container",
  "height": 360,

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/all-substances-by-state.csv"
  },

  "params": [
    {
      "name": "hover_state",
      "select": {
        "type": "point",
        "fields": ["state"],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],

  "mark": {
    "type": "point",
    "filled": true,
    "stroke": "#FAF7F0",
    "strokeWidth": 1.2
  },

  "encoding": {
    "x": {
      "field": "smoking",
      "type": "quantitative",
      "title": "Smoking (%)"
    },

    "y": {
      "field": "drugs",
      "type": "quantitative",
      "title": "Drug use (%)"
    },

    "size": {
      "field": "vaping",
      "type": "quantitative",
      "scale": { "range": [80, 900] },
      "legend": { "title": "Vaping intensity (%)" }
    },

    "color": {
      "field": "state",
      "type": "nominal",
      "scale": { "scheme": "tableau10" },
      "legend": { "title": "State" }
    },

    "opacity": {
      "condition": {
        "param": "hover_state",
        "value": 1
      },
      "value": 0.35
    },

    "strokeWidth": {
      "condition": {
        "param": "hover_state",
        "value": 3
      },
      "value": 1
    },

    "tooltip": [
      { "field": "state_full", "type": "nominal", "title": "State" },
      { "field": "smoking", "type": "quantitative", "format": ".1f" },
      { "field": "drugs", "type": "quantitative", "format": ".1f" },
      { "field": "vaping", "type": "quantitative", "format": ".1f" }
    ]
  },

  "config": {
    "background": "transparent",
    "font": "Lato, sans-serif",

    "view": {
      "stroke": null,
      "fill": "transparent"
    },

    "axis": {
      "domain": false,
      "ticks": false,
      "labelColor": "#7A6040",
      "gridColor": "#E8DFD0",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleColor": "#3B2A14",
      "titlePadding": 8
    }
  }
}
