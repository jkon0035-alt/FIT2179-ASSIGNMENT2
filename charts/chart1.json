{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-trend.csv"
  },
  "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {"format": "d", "grid": false}
    },
    "y": {
      "field": "percent",
      "type": "quantitative",
      "title": "% of population (14+)",
      "scale": {"domain": [0, 70]}
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Smoking Status"
    }
  },
  "config": {
    "background": "transparent"
  }
}
