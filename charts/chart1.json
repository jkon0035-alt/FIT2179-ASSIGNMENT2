{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annotated line + area — Smoking Rates in Australia 2001-2022",
  "width": "container", "height": 340,
  "data": {"url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/smoking-trend.csv"},
  "layer": [
    {
      "mark": {"type": "area", "opacity": 0.12, "color": "#D2691E", "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "current", "type": "quantitative", "scale": {"domain": [0,30]}},
        "y2": {"datum": 0}
      }
    },
    {
      "mark": {"type": "area", "opacity": 0.1, "color": "#C8B89A", "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "current", "type": "quantitative"},
        "y2": {"field": "daily"}
      }
    },
    {
      "mark": {"type": "rule", "strokeDash": [4,3], "color": "#B8A080", "strokeWidth": 1},
      "data": {"values": [{"year": 2012}]},
      "encoding": {"x": {"field": "year", "type": "quantitative"}}
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 5, "dy": -46, "fontSize": 9.5, "color": "#B8A080", "fontStyle": "italic", "font": "Lato, sans-serif"},
      "data": {"values": [{"year": 2012, "label": "Plain packaging (2012)"}]},
      "encoding": {"x": {"field": "year", "type": "quantitative"}, "text": {"field": "label"}}
    },
    {
      "params": [{"name": "hov", "select": {"type": "point", "nearest": true, "on": "mouseover", "encodings": ["x"], "clear": "mouseout"}}],
      "mark": {"type": "point", "opacity": 0, "size": 200},
      "encoding": {"x": {"field": "year", "type": "quantitative"}, "y": {"field": "current", "type": "quantitative"}}
    },
    {
      "mark": {"type": "rule", "strokeDash": [3,3], "color": "#C8B89A", "strokeWidth": 1},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "opacity": {"condition": {"param": "hov", "empty": false, "value": 0.8}, "value": 0}
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "color": "#D2691E", "strokeCap": "round", "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative", "title": "Year", "axis": {"format": "d", "grid": false}},
        "y": {"field": "current", "type": "quantitative", "title": "% of population (14+)", "scale": {"domain": [0,30]}, "axis": {"grid": true}}
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "color": "#8B4513", "strokeCap": "round", "interpolate": "monotone"},
      "encoding": {"x": {"field": "year", "type": "quantitative"}, "y": {"field": "daily", "type": "quantitative"}}
    },
    {
      "mark": {"type": "point", "filled": true, "color": "#D2691E", "stroke": "#FAF7F0", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"}, "y": {"field": "current", "type": "quantitative"},
        "size": {"condition": {"param": "hov", "empty": false, "value": 200}, "value": 60},
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "current", "type": "quantitative", "title": "Current smokers (%)", "format": ".1f"},
          {"field": "daily", "type": "quantitative", "title": "Daily smokers (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "point", "filled": true, "color": "#8B4513", "stroke": "#FAF7F0", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"}, "y": {"field": "daily", "type": "quantitative"},
        "size": {"condition": {"param": "hov", "empty": false, "value": 200}, "value": 60}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 11, "fontWeight": 700, "font": "Lato, sans-serif"},
      "transform": [{"filter": "datum.year == 2022"}],
      "encoding": {
        "x": {"field": "year", "type": "quantitative"}, "y": {"field": "current", "type": "quantitative"},
        "text": {"value": "Current"}, "color": {"value": "#D2691E"}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 11, "fontWeight": 700, "font": "Lato, sans-serif"},
      "transform": [{"filter": "datum.year == 2022"}],
      "encoding": {
        "x": {"field": "year", "type": "quantitative"}, "y": {"field": "daily", "type": "quantitative"},
        "text": {"value": "Daily"}, "color": {"value": "#8B4513"}
      }
    }
  ],
  "config": {
    "background": "transparent", "font": "Lato, sans-serif",
    "view": {"stroke": null, "fill": "transparent"},
    "axis": {"domain": false, "ticks": false, "labelFontSize": 11, "labelColor": "#7A6040", "labelPadding": 6, "titleFontSize": 11, "titleFontWeight": 700, "titleColor": "#3B2A14", "titlePadding": 10, "gridColor": "#E8DFD0"},
    "legend": {"labelFontSize": 11, "labelColor": "#7A6040", "titleFontSize": 11, "titleColor": "#3B2A14", "symbolSize": 100, "padding": 6, "cornerRadius": 2, "fillColor": "#FAF7F0", "strokeColor": "#C8B89A"},
    "line": {"strokeWidth": 2.5}, "point": {"strokeWidth": 1.5}, "area": {"opacity": 0.8}
  }
}
