{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples horizontal line chart — drug use by age group",

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/drug-by-age.csv"
  },

  "transform": [
    {
      "calculate": "toNumber(datum.recent_use_percent)",
      "as": "value"
    }
  ],

  "facet": {
    "column": {
      "field": "drug",
      "type": "nominal",
      "title": null
    }
  },

  "spec": {
    "width": 250,
    "height": 250,

    "mark": {
      "type": "line",
      "strokeWidth": 3,
      "point": {
        "filled": true,
        "size": 60
      }
    },

    "encoding": {
      "x": {
        "field": "age_group",
        "type": "ordinal",
        "sort": ["14–19", "20–29", "30–39", "40–49", "50–59", "60+"],
        "title": "Age Group",
        "axis": {
          "labelAngle": -25,
          "labelColor": "#7A6040",
          "grid": false
        }
      },

      "y": {
        "field": "value",
        "type": "quantitative",
        "title": "Use (%)",
        "axis": {
          "labelColor": "#3B2A14",
          "gridColor": "#E8DFD0"
        }
      },

      "color": {
        "field": "drug",
        "type": "nominal",
        "legend": null,
        "scale": {
          "domain": ["Cannabis", "Cocaine", "Ecstasy", "Meth"],
          "range": ["#4A7C59", "#B03030", "#4A7C8B", "#D2691E"]
        }
      },

      "tooltip": [
        { "field": "drug", "title": "Drug" },
        { "field": "age_group", "title": "Age Group" },
        { "field": "value", "title": "Use (%)" }
      ]
    }
  },

  "config": {
    "background": "transparent",
    "view": { "stroke": null },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelFont": "Lato"
    }
  }
}
