{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Daily and current smoking rates in Australia 2001–2022",
  "width": "container",
  "height": 300,
  "background": "#FAF7F0",
  "config": {
    "font": "Georgia, serif",
    "axis": {
      "domainColor": "#C8B89A",
      "gridColor": "#E8DFD0",
      "tickColor": "#C8B89A",
      "labelColor": "#5C4A2A",
      "titleColor": "#5C4A2A",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#5C4A2A",
      "titleColor": "#5C4A2A",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "view": { "stroke": "transparent" }
  },
  "data": { "url": "data/smoking-trend.csv" },
  "transform": [
    { "fold": ["daily_smoker_pct", "current_smoker_pct"], "as": ["type", "pct"] },
    {
      "calculate": "datum.type === 'daily_smoker_pct' ? 'Daily smokers' : 'Current smokers'",
      "as": "Smoking type"
    }
  ],
  "layer": [
    {
      "mark": { "type": "area", "opacity": 0.15, "interpolate": "monotone" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal", "axis": { "title": "Year", "labelAngle": 0 } },
        "y": { "field": "pct", "type": "quantitative", "scale": { "domain": [0, 28] }, "axis": { "title": "% of population (aged 14+)", "format": ".0f" } },
        "color": {
          "field": "Smoking type",
          "type": "nominal",
          "scale": { "domain": ["Daily smokers", "Current smokers"], "range": ["#8B4513", "#D2691E"] },
          "legend": { "orient": "top-left", "title": null }
        }
      }
    },
    {
      "mark": { "type": "line", "strokeWidth": 2.5, "interpolate": "monotone" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" },
        "color": {
          "field": "Smoking type",
          "type": "nominal",
          "scale": { "domain": ["Daily smokers", "Current smokers"], "range": ["#8B4513", "#D2691E"] }
        }
      }
    },
    {
      "mark": { "type": "point", "size": 70, "filled": true },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" },
        "color": {
          "field": "Smoking type",
          "type": "nominal",
          "scale": { "domain": ["Daily smokers", "Current smokers"], "range": ["#8B4513", "#D2691E"] }
        },
        "tooltip": [
          { "field": "year", "title": "Year" },
          { "field": "Smoking type", "title": "Category" },
          { "field": "pct", "title": "Rate (%)", "format": ".1f" }
        ]
      }
    }
  ]
}
