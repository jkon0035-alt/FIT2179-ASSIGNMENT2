{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Drug prevalence donut chart (interactive version)",
  "width": 360,
  "height": 360,

  "data": {
    "values": [
      {"drug": "Cannabis", "value": 11.5},
      {"drug": "Cocaine", "value": 4.5},
      {"drug": "Ecstasy", "value": 2.1},
      {"drug": "Hallucinogens", "value": 2.4},
      {"drug": "Meth/Amphetamine", "value": 1.0},
      {"drug": "Ketamine", "value": 1.4},
      {"drug": "Inhalants", "value": 1.4},
      {"drug": "Heroin", "value": 0.1}
    ]
  },

  "params": [
    {
      "name": "selection",
      "select": {
        "type": "point",
        "fields": ["drug"],
        "on": "click",
        "clear": "dblclick"
      },
      "bind": "legend"
    }
  ],

  "mark": {
    "type": "arc",
    "innerRadius": 70,
    "padAngle": 0,
    "stroke": "#FAF7F0",
    "strokeWidth": 1
  },

  "encoding": {
    "theta": {
      "field": "value",
      "type": "quantitative"
    },

    "color": {
      "field": "drug",
      "type": "nominal",
      "scale": {
        "range": [
          "#587665",
          "#AC6C49",
          "#B5BD89",
          "#EC9192",
          "#58A4B0",
          "#5D737E",
          "#6F5E50",
          "#81483E"
        ]
      },
      "legend": {
        "orient": "right",
        "title": "Drug Type"
      }
    },

    "opacity": {
      "condition": {
        "param": "selection",
        "value": 1
      },
      "value": 0.3
    },

    "tooltip": [
      {"field": "drug", "type": "nominal"},
      {"field": "value", "type": "quantitative", "title": "Prevalence (%)"}
    ]
  }
}
