{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples cross-filter — substances-by-state-long.csv",
  "data": {"url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/substances-by-state-long.csv"},
  "params": [{"name": "sp", "select": {"type": "point", "fields": ["state"]}}],
  "facet": {
    "field": "substance", "type": "nominal", "title": null,
    "sort": ["Smoking","Vaping","Drugs"],
    "header": {
      "labelFontSize": 13, "labelFontWeight": 700,
      "labelFont": "Playfair Display, Georgia, serif",
      "labelColor": "#3B2A14", "labelOrient": "top", "labelPadding": 10
    }
  },
  "spec": {
    "width": 240, "height": 230,
    "mark": {"type": "bar", "cornerRadius": 2},
    "encoding": {
      "y": {"field": "state", "type": "nominal", "sort": "-x", "title": null, "axis": {"labelFontSize": 11, "labelColor": "#3B2A14", "grid": false}},
      "x": {"field": "percent", "type": "quantitative", "title": "Rate (%)", "scale": {"domain": [0,30]}, "axis": {"grid": true}},
      "color": {
        "field": "substance", "type": "nominal",
        "scale": {"domain": ["Smoking","Vaping","Drugs"], "range": ["#8B4513","#4A7C8B","#4A7C59"]},
        "legend": null
      },
      "opacity": {"condition": {"param": "sp", "value": 1}, "value": 0.15},
      "tooltip": [
        {"field": "state_full", "type": "nominal",      "title": "State"},
        {"field": "substance",  "type": "nominal",      "title": "Substance"},
        {"field": "percent",    "type": "quantitative", "title": "Rate (%)", "format": ".1f"}
      ]
    }
  },
  "columns": 3,
  "spacing": {"row": 28, "column": 20},
  "config": {
    "background": "transparent", "font": "Lato, sans-serif",
    "view": {"stroke": "#C8B89A", "strokeWidth": 1, "fill": "transparent"},
    "axis": {"domain": false, "ticks": false, "labelFontSize": 11, "labelColor": "#7A6040", "labelPadding": 6, "titleFontSize": 11, "titleFontWeight": 700, "titleColor": "#3B2A14", "titlePadding": 10, "gridColor": "#E8DFD0"},
    "legend": {"labelFontSize": 11, "labelColor": "#7A6040", "titleFontSize": 11, "titleColor": "#3B2A14", "symbolSize": 100, "padding": 6, "cornerRadius": 2, "fillColor": "#FAF7F0", "strokeColor": "#C8B89A"},
    "bar": {"cornerRadius": 2}
  }
}
