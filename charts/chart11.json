{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 11 - safe interactive stacked bar",

  "data": {
    "url": "https://raw.githubusercontent.com/jkon0035-alt/FIT2179-ASSIGNMENT2/main/data/substances-by-state-long.csv"
  },

  "params": [
    {
      "name": "substance_click",
      "select": {
        "type": "point",
        "fields": ["substance"]
      },
      "bind": "legend"
    }
  ],

  "width": 600,
  "height": 340,

  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 4,
    "cornerRadiusTopRight": 4
  },

  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "axis": {
        "labelFontSize": 11,
        "labelColor": "#3B2A14",
        "title": null,
        "labelAngle": -30
      }
    },

    "y": {
      "field": "percent",
      "type": "quantitative",
      "stack": "zero",
      "title": "Rate (%)",
      "axis": {
        "grid": true,
        "labelColor": "#7A6040"
      }
    },

    "color": {
      "field": "substance",
      "type": "nominal",
      "scale": {
        "range": [
          "#BCAA99",
          "#886F68",
          "#3D2C2E"
        ]
      },
      "legend": {
        "title": "Substance"
      }
    },

    "fillOpacity": {
      "condition": {
        "param": "substance_click",
        "value": 1
      },
      "value": 0.3
    },

    "tooltip": [
      { "field": "state", "type": "nominal", "title": "State" },
      { "field": "substance", "type": "nominal", "title": "Substance" },
      { "field": "percent", "type": "quantitative", "title": "Rate (%)", "format": ".1f" }
    ]
  },

  "config": {
    "font": "Lato, sans-serif",
    "axis": {
      "domain": false,
      "ticks": false,
      "gridColor": "#E8DFD0",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleColor": "#3B2A14"
    }
  }
}
